# Database Configuration
DB_HOST=localhost
DB_NAME=BarqDb
DB_USER=barq_user
DB_PASSWORD=YourStrong@Passw0rd
DB_PORT=5432

# Redis Configuration
REDIS_CONNECTION_STRING=localhost:6379

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-change-in-production
JWT_ISSUER=BarqAPI
JWT_AUDIENCE=BarqClient

# Container Images (for Kubernetes)
BACKEND_IMAGE=barq/backend:latest
FRONTEND_IMAGE=barq/frontend:latest

# Security Configuration
ENABLE_SECURITY_HEADERS=true
ENABLE_WAF=true
ENABLE_RATE_LIMITING=true

# WAF Configuration
WAF_EXCLUDED_PATHS=/health,/health/ready,/health/live,/health/startup

# Logging Configuration
LOG_LEVEL=Information
SERILOG_MINIMUM_LEVEL=Information

# Environment
ASPNETCORE_ENVIRONMENT=Development
