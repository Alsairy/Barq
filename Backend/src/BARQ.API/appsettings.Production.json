{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.your-prod.domain",
      "https://admin.your-prod.domain"
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Secret": ""
  },
  "Auth": {
    "Cookie": {
      "Enabled": true,
      "Name": "__Host-Auth",
      "Domain": null,
      "Path": "/",
      "SameSite": "None",
      "Secure": true
    }
  }
}
